{
    "$schema": "https://opencode.ai/config.json",
    "plugin": [
        "@dietrichgebert/ponytail",
        "oh-my-opencode-slim"
    ],
    "lsp": false,
    "mcp": {
        "atlassian": {
            "type": "remote",
            "url": "https://mcp.atlassian.com/v2/mcp",
            "enabled": true
        },
        "dbx": {
            "type": "local",
            "command": [
                "npx",
                "-y",
                "@dbx-app/mcp-server"
            ],
            "environment": {
                "DBX_MCP_ALLOW_WRITES": "0"
            }
        }
    },
    "compaction": {
        "auto": true,
        "prune": true,
        "reserved": 120000
    }
}
