{
    "experimental": {
        "policies": [
            // Best-effort path/command guardrails, not a sandbox.
            { "action": "permission", "resource": "read:*.env", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.env", "effect": "deny" },
            { "action": "permission", "resource": "read:*.env.*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.env.*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.git-credentials", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.git-credentials", "effect": "deny" },
            { "action": "permission", "resource": "read:*.netrc", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.netrc", "effect": "deny" },
            { "action": "permission", "resource": "read:*.npmrc", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.npmrc", "effect": "deny" },
            { "action": "permission", "resource": "read:*.pypirc", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.pypirc", "effect": "deny" },
            { "action": "permission", "resource": "read:*id_rsa*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*id_rsa*", "effect": "deny" },
            { "action": "permission", "resource": "read:*id_dsa*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*id_dsa*", "effect": "deny" },
            { "action": "permission", "resource": "read:*id_ecdsa*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*id_ecdsa*", "effect": "deny" },
            { "action": "permission", "resource": "read:*id_ed25519*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*id_ed25519*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.p12", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.p12", "effect": "deny" },
            { "action": "permission", "resource": "read:*.pfx", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.pfx", "effect": "deny" },
            { "action": "permission", "resource": "read:*.ssh", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.ssh", "effect": "deny" },
            { "action": "permission", "resource": "read:*.ssh/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.ssh/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.gnupg", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.gnupg", "effect": "deny" },
            { "action": "permission", "resource": "read:*.gnupg/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.gnupg/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.aws", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.aws", "effect": "deny" },
            { "action": "permission", "resource": "read:*.aws/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.aws/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.azure", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.azure", "effect": "deny" },
            { "action": "permission", "resource": "read:*.azure/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.azure/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.kube", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.kube", "effect": "deny" },
            { "action": "permission", "resource": "read:*.kube/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.kube/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.config/gcloud", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.config/gcloud", "effect": "deny" },
            { "action": "permission", "resource": "read:*.config/gcloud/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.config/gcloud/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.password-store", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.password-store", "effect": "deny" },
            { "action": "permission", "resource": "read:*.password-store/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.password-store/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*.local/share/keyrings", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.local/share/keyrings", "effect": "deny" },
            { "action": "permission", "resource": "read:*.local/share/keyrings/*", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.local/share/keyrings/*", "effect": "deny" },
            { "action": "permission", "resource": "read:*opencode/auth.json", "effect": "deny" },
            { "action": "permission", "resource": "edit:*opencode/auth.json", "effect": "deny" },
            { "action": "permission", "resource": "read:*opencode/opencode.json", "effect": "deny" },
            { "action": "permission", "resource": "edit:*opencode/opencode.json", "effect": "deny" },
            { "action": "permission", "resource": "read:*opencode/opencode.jsonc", "effect": "deny" },
            { "action": "permission", "resource": "edit:*opencode/opencode.jsonc", "effect": "deny" },
            // Deny Git commands and metadata edits; only these exact commands are allowed.
            { "action": "permission", "resource": "shell:git *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/git *", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.git", "effect": "deny" },
            { "action": "permission", "resource": "edit:*.git/*", "effect": "deny" },
            { "action": "permission", "resource": "shell:git status", "effect": "allow" },
            { "action": "permission", "resource": "shell:git status --short", "effect": "allow" },
            { "action": "permission", "resource": "shell:git diff --stat", "effect": "allow" },
            { "action": "permission", "resource": "shell:git diff --name-only", "effect": "allow" },
            { "action": "permission", "resource": "shell:git log --oneline", "effect": "allow" },
            { "action": "permission", "resource": "shell:git branch --show-current", "effect": "allow" },
            // Best-effort destructive-command blocks; ordinary coding/tests remain available.
            { "action": "permission", "resource": "shell:rm *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/rm *", "effect": "deny" },
            { "action": "permission", "resource": "shell:rmdir *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/rmdir *", "effect": "deny" },
            { "action": "permission", "resource": "shell:unlink *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/unlink *", "effect": "deny" },
            { "action": "permission", "resource": "shell:shred *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/shred *", "effect": "deny" },
            { "action": "permission", "resource": "shell:truncate *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/truncate *", "effect": "deny" },
            { "action": "permission", "resource": "shell:dd *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/dd *", "effect": "deny" },
            { "action": "permission", "resource": "shell:mkfs *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/mkfs *", "effect": "deny" },
            { "action": "permission", "resource": "shell:mkfs.* *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/mkfs.* *", "effect": "deny" },
            { "action": "permission", "resource": "shell:wipefs *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/wipefs *", "effect": "deny" },
            { "action": "permission", "resource": "shell:fdisk *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/fdisk *", "effect": "deny" },
            { "action": "permission", "resource": "shell:sfdisk *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/sfdisk *", "effect": "deny" },
            { "action": "permission", "resource": "shell:parted *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/parted *", "effect": "deny" },
            { "action": "permission", "resource": "shell:sudo *", "effect": "deny" },
            { "action": "permission", "resource": "shell:*/sudo *", "effect": "deny" }
        ]
    },
    "$schema": "https://opencode.ai/config.json",
    "plugins": [
        "./plugins/ponytail",
        "oh-my-opencode-slim"
    ],
    "lsp": false,
    "mcp": {
        "servers": {
            "atlassian": {
                "type": "remote",
                "url": "https://mcp.atlassian.com/v2/mcp"
            },
            "dbx": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@dbx-app/mcp-server"
                ],
                "environment": {
                    "DBX_MCP_ALLOW_WRITES": "0"
                }
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@latest"
                ]
            }
        }
    },
    "compaction": {
        "auto": true,
        "buffer": 120000
    }
}
