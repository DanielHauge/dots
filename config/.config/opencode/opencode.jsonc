{
    "$schema": "https://opencode.ai/config.json",
    "plugins": [
        "@dietrichgebert/ponytail",
        "oh-my-opencode-slim"
    ],
    "lsp": false,
    "mcp": {
        "servers": {
            "atlassian": {
                "type": "remote",
                "url": "https://mcp.atlassian.com/v2/mcp"
            },
            "dbx": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@dbx-app/mcp-server"
                ],
                "environment": {
                    "DBX_MCP_ALLOW_WRITES": "0"
                }
            },
            "chrome-devtools": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "chrome-devtools-mcp@latest"
                ]
            }
        }
    },
    "compaction": {
        "auto": true,
        "buffer": 120000
    }
}
