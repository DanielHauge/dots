#!/usr/bin/env bash
#> Cast a video file to a TV using go2tv
function cast() {
    if (($# != 1)); then
        echo "Usage: cast <video>"
        return 1
    fi

    local video="$1"
    [[ ! -f "$video" ]] && {
        echo "Error: file not found: $video"
        return 1
    }

    local target
    target=$(_cast_target) || return $?
    [ -n "$target" ] || return 0

    if ! command -v ffprobe >/dev/null 2>&1; then
        printf '%s\n' 'cast: ffprobe is required.' >&2
        return 1
    fi

    # Does it contain subtitles?
    if ffprobe -v error \
        -select_streams s:0 \
        -show_entries stream=index \
        -of csv=p=0 \
        "$video" | grep -q .; then

        if ! command -v ffmpeg >/dev/null 2>&1; then
            printf '%s\n' 'cast: ffmpeg is required to extract subtitles.' >&2
            return 1
        fi
        local subs="/tmp/cast-${$}.srt"

        echo "Extracting subtitles..."

        ffmpeg -hide_banner -loglevel error \
            -i "$video" \
            -map 0:s:0 \
            -c:s srt \
            -y "$subs" || return 1

        # Strip any ASS override tags that survived conversion
        sed -Ei 's/\{\\[^}]*\}//g' "$subs"

        echo "Casting with subtitles..."
        go2tv -t "$target" -v "$video" -s "$subs"

        rm -f "$subs"
    else
        echo "Casting..."
        go2tv -t "$target" -v "$video"
    fi
}
